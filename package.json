{
  "name": "hrms-system",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "cross-env TZ=Asia/Kolkata NODE_ENV=development NODE_OPTIONS=--max-old-space-size=6144 NEXT_DISABLE_REACT_DEV_OVERLAY=1 NEXT_DIST_DIR=.next-dev NEXT_ASSET_PREFIX=/__talio_dev_assets node server.js",
    "dev:next": "cross-env TZ=Asia/Kolkata NODE_ENV=development NEXT_DIST_DIR=.next-dev-next next dev",
    "build": "cross-env TZ=Asia/Kolkata NODE_OPTIONS=--max-old-space-size=8192 SKIP_ENV_VALIDATION=true next build",
    "vercel-build": "npm run build",
    "start": "cross-env TZ=Asia/Kolkata node server.js",
    "start:next": "cross-env TZ=Asia/Kolkata next start",
    "lint": "next lint",
    "seed": "node scripts/seed.js",
    "migrate:designation-levels": "node scripts/migrate-designation-levels.js",
    "migrate:hrms-workflows": "node scripts/migrate-hrms-workflow-kernel.js",
    "attendance:bridge": "node scripts/talio-attendance-bridge.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:socket": "jest tests/socket --verbose",
    "test:api": "jest tests/api --verbose",
    "test:e2e": "jest tests/e2e --verbose --runInBand",
    "test:web": "jest tests/web --verbose",
    "test:mobile": "jest tests/mobile --verbose"
  },
  "dependencies": {
