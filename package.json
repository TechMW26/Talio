    "node-schedule": "^2.1.1",
    "nodemailer": "^9.0.6",
    "pusher": "^5.3.2",
    "pusher-js": "^8.4.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.4.0",
    "react-markdown": "^9.1.0",
    "recharts": "^2.14.1",
    "redis": "^4.6.13",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "swr": "^2.3.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.15.21",
