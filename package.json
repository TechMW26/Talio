    "@sentry/nextjs": "^10.37.0",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.5",
    "@vercel/queue": "^0.5.1",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "firebase": "^11.9.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.28.1",
    "fuse.js": "^7.1.0",
    "googleapis": "^176.0.0",
    "jose": "^6.1.3",
    "jsonrepair": "^3.14.0",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.2",
    "livekit-client": "2.15.6",
    "livekit-server-sdk": "^2.18.0",
