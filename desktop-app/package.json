{
  "name": "talio-desktop",
  "version": "6.0.2",
  "description": "Talio HRMS Desktop - Productivity & Collaboration Hub",
  "main": "src/main.js",
  "author": "MW FutureTech <support@talio.in>",
  "homepage": "https://app.talio.in",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build": "npm run build:mac && npm run build:win",
    "build:mac": "electron-builder --mac --x64 --arm64",
    "build:mac-intel": "electron-builder --mac --x64",
    "build:mac-arm": "electron-builder --mac --arm64",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux --x64",
    "build:linux-arm64": "electron-builder --linux --arm64",
    "build:signed": "CSC_LINK=$CSC_LINK CSC_KEY_PASSWORD=$CSC_KEY_PASSWORD npm run build",
    "setup:notary-profile": "bash ./scripts/setup-notary-profile.sh",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "electron-store": "^8.1.0",
    "form-data": "^4.0.0",
    "node-fetch": "^2.7.0",
    "socket.io-client": "^4.7.4"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "in.talio.desktop",
    "productName": "Talio",
    "copyright": "Copyright \u00a9 2026 MW FutureTech. All rights reserved.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon-256.png",
      "build/icon.ico",
      "build/icon.icns",
      "build/trayIconTemplate.png",
      "build/trayIconTemplate@2x.png",
      "package.json"
    ],
    "asarUnpack": [
      "src/guardian.js"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "signIgnore": [],
      "type": "distribution",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "sign": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "afterSign": "scripts/notarize.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "Talio is a registered trademark of MW FutureTech.",
      "requestedExecutionLevel": "asInvoker",
      "signExts": [
        ".dll"
      ],
      "signtoolOptions": {
        "publisherName": "MW FutureTech",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "timeStampServer": "http://timestamp.digicert.com",
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "verifyUpdateCodeSignature": false,
      "artifactName": "${productName}.Setup.${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Talio",
      "artifactName": "${productName}.Setup.${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "MW FutureTech <support@talio.in>",
      "vendor": "MW FutureTech",
      "synopsis": "Talio HRMS Desktop App",
      "description": "Talio HRMS Desktop - Productivity & Collaboration Hub",
      "executableName": "talio-desktop",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libappindicator3-1",
        "libsecret-1-0",
        "libxss1"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}