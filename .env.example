# ===========================================
# TALIO HRMS - ENVIRONMENT VARIABLES
# ===========================================
# IMPORTANT: Copy this file to .env (NOT .env.local)
# Fill in your actual values in .env
# DO NOT commit .env to git - it contains secrets

# ===========================================
# DATABASE CONFIGURATION (MULTI-TENANT)
# ===========================================
# MongoDB connection string - DO NOT specify a database name in the URI
# The system uses dynamic tenant databases based on user login
# Each tenant has their own isolated database
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/?retryWrites=true&w=majority

# NOTE: MONGODB_DB_NAME is DEPRECATED - multi-tenant system uses dynamic database selection
# Each user is mapped to their tenant's database via the superadmin UserTenantMapping collection

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
# NextAuth Configuration
NEXTAUTH_URL=https://app.talio.in
NEXTAUTH_SECRET=your-super-secure-nextauth-secret-key-here

# JWT Secret for API authentication
JWT_SECRET=your-super-secure-jwt-secret-key-here

# Onboarding Password Encryption Key (AES-256)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If not set, a key is derived from JWT_SECRET automatically
ONBOARDING_PASSWORD_KEY=

# =========================================== 
# APPLICATION CONFIGURATION
# ===========================================
# App Name and URL
NEXT_PUBLIC_APP_NAME=Talio HRMS
NEXT_PUBLIC_APP_URL=https://app.talio.in

# Legacy VPS Socket.IO origins. Vercel uses managed Pusher channels below.
SOCKET_ALLOWED_ORIGINS=https://app.talio.in

# Per-tenant MongoDB pool limits. Keep these conservative because total
# connections scale with the number of active tenant databases.
TENANT_DB_MAX_POOL_SIZE=3
TENANT_DB_MIN_POOL_SIZE=0

# ===========================================
# VERCEL MANAGED SERVICES
# ===========================================
# Create a PRIVATE Vercel Blob store linked to this project. Vercel adds the
# token automatically; BLOB_ACCESS must match the store access mode.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token
BLOB_ACCESS=private

# Managed realtime replaces the long-running Socket.IO server on Vercel.
NEXT_PUBLIC_REALTIME_PROVIDER=pusher
NEXT_PUBLIC_PUSHER_KEY=your-pusher-key
NEXT_PUBLIC_PUSHER_CLUSTER=ap2
PUSHER_APP_ID=your-pusher-app-id
PUSHER_KEY=your-pusher-key
PUSHER_SECRET=your-pusher-secret
PUSHER_CLUSTER=ap2

# Managed WebRTC/SFU for Vercel-hosted Talio Meet. Keep secrets server-only.
NEXT_PUBLIC_MEETING_TRANSPORT=livekit
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Vercel Queues authenticate through project OIDC; no static queue secret is
# required. Keep the queue and functions near the MongoDB deployment.
QUEUE_REGION=bom1

# Optional durable distributed cache (recommended for cross-instance caching).
REDIS_URL=rediss://default:password@host:port

# ===========================================
# LATEST GITHUB RELEASE DOWNLOADS
# ===========================================
# Used by /api/latest-release, /download/latest, and /webhooks/github-release.
# GITHUB_TOKEN can be omitted for public repositories, but is recommended to
# avoid rate limits and required for private release assets. The legacy GH_TOKEN
# variable is also accepted as a fallback.
GITHUB_OWNER=avirajsharma-ops
GITHUB_REPO=Talio
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32
PUBLIC_BASE_URL=https://app.talio.in
# Optional: choose a specific asset when a release has multiple installers.
# RELEASE_ASSET_NAME=Talio.Setup.5.2.0.exe
# RELEASE_ASSET_PATTERN=Talio\\.Setup\\..*\\.exe$
# Installers are streamed by GitHub Releases; Vercel never stores them locally.

# ===========================================
# MEETINGS (WEBRTC)
# ===========================================
# Talio meetings work with STUN only. TURN is optional, but recommended for production reliability because STUN-only can connect signaling while media fails on some office, mobile, or carrier-grade NAT networks.
# Comma-separated URL lists are supported.
NEXT_PUBLIC_MEETING_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302,stun:stun3.l.google.com:19302
# Leave the TURN values empty if you are not using TURN.
# TURN credentials are visible to browsers. Prefer short-lived or restricted relay credentials when your TURN provider supports them.
NEXT_PUBLIC_MEETING_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
NEXT_PUBLIC_MEETING_TURN_USERNAME=your-turn-username
NEXT_PUBLIC_MEETING_TURN_CREDENTIAL=your-turn-password

# ===========================================
# EMAIL CONFIGURATION (SMTP)
# ===========================================
# For sending notifications and emails (e.g. Hostinger SMTP)
# Hostinger SMTP (example - replace with your actual mailbox & password in .env.local / server env)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_SECURE=true

# SMTP Authentication (sender mailbox)
EMAIL_USER=info@talio.in
EMAIL_PASSWORD=your-email-password

# Email Sender Information
EMAIL_FROM_NAME=Talio HRMS
EMAIL_FROM_EMAIL=info@talio.in

# ===========================================
# FILE UPLOAD CONFIGURATION
# ===========================================
# Browser uploads go directly to Vercel Blob, bypassing the 4.5 MB Function
# request limit. The application policy currently caps files at 25 MB.
MAX_FILE_SIZE=26214400

# ===========================================
# ADDITIONAL PRODUCTION SETTINGS
# ===========================================
# Node Environment
NODE_ENV=production

# API Rate Limiting (requests per minute)
RATE_LIMIT_MAX=100

# Session Configuration
SESSION_MAX_AGE=604800

# ===========================================
# GOOGLE OAUTH CONFIGURATION
# ===========================================
# Required for Google Sign-In and Gmail Integration functionality
# Get these from: https://console.cloud.google.com/
# 1. Go to APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add authorized redirect URIs:
#    - https://yourapp.com/api/auth/callback/google (for sign-in)
#    - https://yourapp.com/api/mail/callback (for Gmail integration)
# 4. Enable Gmail API in APIs & Services → Library
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===========================================
# LINKEDIN RECRUITMENT INTEGRATION
# ===========================================
# Required for the recruitment LinkedIn connect flow.
# Get LinkedIn credentials from: https://www.linkedin.com/developers/apps
# 1. Create or open your LinkedIn app
# 2. Add the required Sign In / OpenID product for your app
# 3. Open the Auth tab and copy the Client ID and Client Secret
# 4. Add the redirect URL below in LinkedIn exactly as configured in your environment
# 5. Generate the encryption key with: openssl rand -hex 32
# APP_URL is optional if NEXT_PUBLIC_APP_URL already points to the correct base URL.
# LINKEDIN_REDIRECT_URI is optional; if omitted, it resolves to APP_URL + /api/recruitment/linkedin/callback.
# LINKEDIN_APPLICANTS_API_URL is only needed if you want backend-driven applicant fetching.
# Supported placeholders in LINKEDIN_APPLICANTS_API_URL: {jobPostingId}, {jobId}, {since}, {limit}
APP_URL=https://yourapp.com
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=https://yourapp.com/api/recruitment/linkedin/callback
INTEGRATION_TOKEN_ENCRYPTION_KEY=your-64-char-hex-encryption-key
LINKEDIN_WEBHOOK_SECRET=your-linkedin-webhook-secret
LINKEDIN_WEBHOOK_VERIFY_TOKEN=your-linkedin-webhook-verify-token
LINKEDIN_APPLICANTS_API_URL=https://api.linkedin.com/your-applicants-endpoint?jobPostingId={jobPostingId}&since={since}&limit={limit}

# ===========================================
# OPTIONAL: THIRD-PARTY INTEGRATIONS
# ===========================================
# If you plan to integrate with external services

# AWS S3 (if using for file storage)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-s3-bucket-name

# Cloudinary (alternative for file storage)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# SendGrid (for email services)
# SENDGRID_API_KEY=your-sendgrid-api-key
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ===========================================
# MONITORING & ANALYTICS (Optional)
# ===========================================
# Sentry for error tracking

# Google Analytics
# NEXT_PUBLIC_GA_ID=your-google-analytics-id

# Google Maps API Key
# Required for geofencing and location features
# Get from: https://console.cloud.google.com/google/maps-apis/
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ===========================================
# NOTIFICATION SCHEDULER
# ===========================================
# Secret key for cron job that processes scheduled/recurring notifications
# Generate a random string: openssl rand -base64 32
CRON_SECRET=your-random-cron-secret-key-here

# ===========================================
# FIREBASE CLOUD MESSAGING (PUSH NOTIFICATIONS)
# ===========================================
# Firebase enables push notifications for both Android and Web platforms
# 
# HOW TO GET THESE VALUES:
# 1. Go to: https://console.firebase.google.com/
# 2. Select your project (or create new one)
# 3. Click gear icon → Project Settings
#
# FOR CLIENT CONFIG (NEXT_PUBLIC_* variables):
# - Go to "General" tab → "Your apps" section
# - Click "Add app" → Select Web (</>)
# - Register app and copy the config values
#
# FOR SERVER CONFIG (FIREBASE_SERVICE_ACCOUNT_KEY):
# - Go to "Service accounts" tab
# - Click "Generate new private key"
# - Download the JSON file
# - Copy the ENTIRE JSON content (minified, on one line)

# Firebase Client Configuration (Public - safe to expose in browser)
# These enable Firebase in the web browser for receiving notifications
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# VAPID Key for Web Push Notifications (REQUIRED for web push)
# HOW TO GET:
# 1. Go to Project Settings → Cloud Messaging tab
# 2. Scroll to "Web configuration" section
# 3. Click "Generate key pair" under Web Push certificates
# 4. Copy the key pair (public key)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-public-key-here

# Firebase Admin SDK (Private - server only, NEVER expose to client)
# Option 1: Complete service account JSON (RECOMMENDED)
# Paste the entire JSON from the downloaded service account key file
# Make sure it's on ONE LINE with no line breaks
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"...","universe_domain":"googleapis.com"}

# Option 2: Individual fields (legacy - use if Option 1 doesn't work)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"

# Optional: VAPID Private Key for Web Push API (advanced)
# Only needed if you want to use the Web Push API directly (not via FCM)
# Generate with: npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:your-email@example.com

# ===========================================
# AI PROVIDER — Pollinations.ai (exclusive)
# ===========================================
# All AI features (chat, generation, analysis, MIRA, MAYA, whiteboard,
# productivity, holidays, bulk import, etc.) use Pollinations.ai exclusively
# via its OpenAI-compatible REST API.
#
# HOW TO GET A POLLINATIONS KEY:
#   1. Go to: https://enter.pollinations.ai/keys
#   2. Create a secret key (sk_…)
#   3. Copy it below
#
POLLINATIONS_API_KEY=sk_...

# Model configuration (optional — defaults shown)
# POLLINATIONS_TEXT_MODEL=openai
# POLLINATIONS_VISION_MODEL=gemini
# POLLINATIONS_BASE_URL=https://gen.pollinations.ai/v1
# POLLINATIONS_TIMEOUT_MS=60000

# Pollinations Audio (text-to-speech / Call Alerts and speech-to-text / Mira)
# Uses the same POLLINATIONS_API_KEY above.
# POLLINATIONS_TTS_VOICE=nova
# POLLINATIONS_TTS_MODEL=tts-1
# POLLINATIONS_STT_MODEL=whisper-large-v3

# Tavily Search API (for internet access with the AI assistant)
# Get your API key from: https://app.tavily.com/
NEXT_PUBLIC_TAVILY_API_KEY=your-api-key-here


# ===========================================
# DEPRECATED SETTINGS (MULTI-TENANT MIGRATION)
# ===========================================
# MONGODB_DB_NAME is no longer used - database is now determined dynamically per-tenant
# See lib/tenantModels.js and lib/tenantContext.js for multi-tenant implementation
